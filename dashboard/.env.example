# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string. Use the Supabase *transaction pooler* URL
# (Project Settings -> Database -> Connection string -> "Transaction pooler", port 6543).
# The dashboard is serverless (Vercel), so the pooler is required; the direct connection
# (port 5432) exhausts connections.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Optional but strongly recommended on any public deployment: HTTP Basic auth password for
# every page (username can be anything). /api/health stays public and returns no trading data.
DASHBOARD_PASSWORD=
