# Supabase: Project -> Connect -> "Session pooler" connection string (works from GitHub Actions, IPv4).
# Paste it with your real database password.
SUPABASE_DB_URL=postgresql://postgres.PROJECTREF:YOUR_DB_PASSWORD@aws-X-ap-south-1.pooler.supabase.com:5432/postgres
# Optional: set to 1 to skip the nseindia.com report endpoints used for the ASM/GSM lists
# NSE_SKIP_WEBSITE_API=1
